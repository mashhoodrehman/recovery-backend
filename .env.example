# ---- App ----
NODE_ENV=development
PORT=4000
APP_NAME=RecoveryBackend
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=recovery_db
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=30d
JWT_RESET_SECRET=change-me-reset-secret
JWT_RESET_EXPIRES_IN=30m

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=12

# ---- Rate limit ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ---- SMTP / Mail ----
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@recovery.local
MAIL_FROM_NAME=Recovery System
MAIL_SECURE=false

# ---- Logging ----
LOG_LEVEL=info
LOG_DIR=logs

# ---- Firebase Cloud Messaging (push notifications) ----
# Optional. When unset, push notifications are logged instead of sent.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use the full private key with literal \n line breaks, wrapped in quotes
FIREBASE_PRIVATE_KEY=

# ---- Stripe (payments + Stripe Connect payouts) ----
STRIPE_SECRET_KEY=
# From the Stripe CLI or the webhook endpoint settings in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=

# ---- Agora (in-ride voice calls) ----
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---- Redis (shared tower-location/presence state; required for pm2 cluster mode) ----
# Optional in development — falls back to in-memory state on a single process.
REDIS_URL=
