# ---- App ----
NODE_ENV=development
PORT=4000
APP_NAME=RecoveryBackend
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=recovery_db
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=change-me-reset-secret
JWT_RESET_EXPIRES_IN=30m

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=12

# ---- Rate limit ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ---- SMTP / Mail ----
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@recovery.local
MAIL_FROM_NAME=Recovery System
MAIL_SECURE=false

# ---- Logging ----
LOG_LEVEL=info
LOG_DIR=logs
